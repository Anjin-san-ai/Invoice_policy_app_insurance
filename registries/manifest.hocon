{
    # Refer to this document for neuro-san specifications for the agent manifest.hocon file
    # that is used as configuration for neuro-san servers
    # https://github.com/cognizant-ai-lab/neuro-san/blob/main/docs/manifest_hocon_reference.md
    #
    # This deployment serves the invoice-to-pay app plus the agent-network-designer family.
    # The upstream example families (basic, tools, industry, experimental) are excluded, so the
    # server spawns seven networks instead of fifty-seven and starts in a fraction of the time.
    # To restore them, re-add those registry directories and their `include` lines from
    # https://github.com/cognizant-ai-lab/neuro-san-studio.

    #
    # The invoice-to-pay app
    #
    "apps/invoice_to_pay.hocon": {
        "serve": true,
        "public": true,
        "mcp": false
    },

    #
    # Agent network designer family of agents
    #
    "agent_network_designer.hocon": true,
    "agent_network_editor.hocon": {
        # A support network for agent_network_designer: served, but not publicly listed.
        "serve": true,
        "public": false
    },
    "agent_network_instructions_editor.hocon": {
        # A support network for agent_network_designer: served, but not publicly listed.
        "serve": true,
        "public": false
    },
    "agent_network_query_generator.hocon": {
        # A support network for agent_network_designer: served, but not publicly listed.
        "serve": true,
        "public": false
    },
    "agent_network_test_generator.hocon": true,

    # Requires Gmail, Selenium and a separately running nsflow service; off by default upstream.
    "agent_network_architect.hocon": false
}
